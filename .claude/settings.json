{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable-gems \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre_commit.rb\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "ruby --disable-gems \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint.rb\"",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
